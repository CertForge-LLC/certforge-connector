# CertForge connector configuration
# Copy this file to connector.yaml and fill in your values.
#
# SECRETS: Do not put the API key directly in this file.
# Reference an environment variable — the connector expands them at startup.
# Example (systemd): set Environment= in your unit override, or use an EnvironmentFile=.
# Example (Docker):  pass -e CERTFORGE_API_KEY=... or use an env_file in compose.

# URL of your CertForge instance.
certforge_url: https://app.certgovernance.app

# Connector token from CertForge → Settings → API Keys → Connector Tokens.
# Always load from an environment variable — never paste the token directly here.
api_key: $CERTFORGE_API_KEY

# How often to poll CertForge for pending jobs (default 30s).
poll_interval: 30s

# Device topology (host, port, type, TLS context, credentials) is stored in
# CertForge and delivered automatically with each job — no device list needed here.
#
# The optional devices: block below is only for local credential overrides, e.g.
# if you store your device password in a secrets manager and inject it via env var
# rather than saving it in CertForge.  Most deployments can omit it entirely.
#
# devices:
#   - id: "00000000-0000-0000-0000-000000000000"  # CertForge device UUID
#     username: admin
#     password: $SBC_PASSWORD

# Private CA (optional) — sign device CSRs locally instead of sending them to
# CertForge for signing.  Use this when your signing CA is on-prem and you do
# not want CSRs leaving the network.  CertForge is still notified for audit and
# inventory tracking via the ReportCert and MarkDone calls.
#
# private_ca:
#   cert: /etc/certforge-connector/ca.crt   # PEM CA certificate
#   key: /etc/certforge-connector/ca.key    # PEM CA private key (RSA or ECDSA)
#   validity_days: 365                       # signed cert validity; default 365
#
#   # Inventory sync (optional) — push all certs this CA has issued to CertForge
#   # so they appear in the discovery inventory as tracked.  Requires a CA connector
#   # record of type "Private / Internal CA" created in CertForge → Settings → CA Connectors.
#   ca_connector_id: 00000000-0000-0000-0000-000000000000  # ID from CertForge UI
#
#   # Option A: file-based CA (OpenSSL, Easy-RSA, cfssl, etc.)
#   # Point at the directory where your CA writes issued cert PEM files.
#   issued_certs_dir: /etc/pki/CA/newcerts   # OpenSSL default; Easy-RSA: pki/issued/
#   crl_file: /etc/pki/CA/crl.pem           # optional — revoked certs are excluded
#
#   # Option B: HashiCorp Vault PKI secrets engine
#   # The connector lists serials via the Vault API; revocation is read inline.
#   vault_pki:
#     addr: https://vault.example.com        # Vault address
#     token: $VAULT_TOKEN                    # Vault token (or set VAULT_TOKEN env var)
#     mount: pki                             # PKI secrets engine mount path (default: pki)
