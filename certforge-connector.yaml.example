# CertForge connector configuration
# Copy this file to certforge-connector.yaml and fill in your values.

# ─── Connection ───────────────────────────────────────────────────────────────

# URL of your CertForge instance.
certforge_url: https://app.certgovernance.app

# ─── Authentication — choose ONE option ───────────────────────────────────────

# Option A: API key (legacy — plain HTTP through Cloudflare)
# Generated in CertForge under Integrations → Connector Agents → Add Agent.
# Load from an environment variable — never paste the raw token here.
#
# api_key: $CERTFORGE_API_KEY

# Option B: mTLS client certificate (recommended)
# Connects directly to the CertForge mTLS port, bypassing Cloudflare.
# Run the enroll command to generate credentials:
#
#   certforge-connector enroll \
#     --token <one-time-token>   \  # from CertForge → Connector Agents → Enroll
#     --url   <certforge-url>    \
#     --out   ./creds               # writes client.crt, client.key, server.crt
#
# The enroll command prints the exact values to paste below.
#
# mtls_host: usagent.certgov.app   # direct-DNS hostname printed by enroll
# mtls_port: 8443                  # 8443 prod · 8444 dev/preview
# mtls_cert: ./creds/client.crt
# mtls_key:  ./creds/client.key
# mtls_ca:   ./creds/server.crt    # pinned server cert — no system trust store needed

# ─── Poll interval ────────────────────────────────────────────────────────────

# How often to poll CertForge for pending jobs (minimum 30s).
poll_interval: 30s

# ─── no_device_jobs ───────────────────────────────────────────────────────────

# Set to true when this connector instance has no network devices to manage.
# Device job polling, cert reads, and device version checks are skipped.
# CA inventory sync and approval-flow CA signing still work normally.
# Typical use: a dedicated Vault PKI or file-based CA connector running on a
# separate host from the one that reaches your network devices.
# no_device_jobs: false

# ─── Device credentials (advanced — most deployments omit this) ───────────────

# Device registration, connection details, and credentials are managed in
# CertForge under Network Devices — there is normally no device list here.
# The connector receives everything it needs (host, port, type, TLS context)
# with each renewal job.
#
# Use this block only when you need to keep credentials local rather than
# storing them in CertForge — e.g. injecting passwords from a secrets manager
# via environment variables.
#
# devices:
#   - id: "00000000-0000-0000-0000-000000000000"  # UUID from CertForge → Network Devices
#     username: admin
#     password: $SBC1_PASSWORD
#   - id: "11111111-1111-1111-1111-111111111111"
#     username: admin
#     password: $SBC2_PASSWORD

# ─── Private CA / Vault PKI (optional) ───────────────────────────────────────

# Configure a private CA if you want this connector to sign CSRs locally
# (for device renewals and approval-flow cert-manager issuance) using your
# own on-prem CA rather than a cloud CA.
#
# SETUP: Create a "Private / Internal CA (On-Prem Agent)" CA connector in
# CertForge → CA Connectors first. This creates the CA record to assign in
# your Issuance Profile and Domain Trust Policy.
#
# GOVERNANCE: the connector validates every domain against your DTP in CertForge
# before signing (fail-closed — CertForge unreachable = no signing).
#
# ── Vault PKI secrets engine ──
#
# Vault addr/token/mount can be stored in the CertForge UI (CA Connectors → Edit).
# When stored there, cert/key files are NOT required — the connector signs via the
# Vault API and receives credentials from the server on each poll.
#
# Use the YAML block only when you need to override the UI values, e.g. to inject
# the Vault token from a local secrets manager or environment variable:
#
# private_ca:                                  # or private_cas: (list) for multiple
#   ca_connector_id: 00000000-0000-0000-0000-000000000000  # UUID from CertForge UI
#   # cert/key are optional for Vault PKI when vault config is stored in the CertForge UI:
#   # cert: /etc/certforge-connector/ca.crt
#   # key:  /etc/certforge-connector/ca.key
#   vault_pki:
#     addr:  https://vault.example.com   # omit if set in CertForge UI
#     token: $VAULT_TOKEN                # env var override; omit to use UI-stored token
#     mount: pki                         # PKI mount path (default: pki)
#     role:  certforge                   # signing role (optional; uses sign-verbatim if empty)
#
# ── File-based CA (OpenSSL, Easy-RSA, cfssl, etc.) ──
#
# Filesystem paths cannot be stored in the CertForge UI — always set them here.
#
# private_ca:
#   ca_connector_id: 00000000-0000-0000-0000-000000000000
#   cert: /etc/certforge-connector/ca.crt
#   key:  /etc/certforge-connector/ca.key
#   validity_days: 365                          # fallback; DTP issuance profile takes precedence
#   issued_certs_dir: /etc/pki/CA/newcerts      # OpenSSL default; Easy-RSA: pki/issued/
#   crl_file: /etc/pki/CA/crl.pem              # optional — revoked certs excluded from inventory push
#
# ── Multiple CAs ──
#
# private_cas:
#   - ca_connector_id: 00000000-0000-0000-0000-000000000000
#     vault_pki:
#       token: $VAULT_TOKEN_1
#   - ca_connector_id: 11111111-1111-1111-1111-111111111111
#     cert: /etc/ca/devices.crt
#     key:  /etc/ca/devices.key
#     issued_certs_dir: /etc/pki/devices/newcerts
